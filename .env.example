# Copy to .env and fill locally. Never commit .env.

AGENTHUB_PUBLIC_HOST=localhost
AGENTHUB_ROOT=.
# Long random strings. Do not put these on CLI argv, URLs, or chat.
AGENTHUB_API_TOKEN=
AGENTHUB_SESSION_SECRET=

# Optional. Publisher stays off until you enable it in hub_config.
# GitHub credentials belong in data/secrets/github.env on the host, not here.
